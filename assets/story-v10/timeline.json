  "segments": [
    {
      "id": "CIN-00",
      "duration": 86.5,
      "frames": 2076,
      "shots": [
        {
          "file": "assets/story-v10/.render-cache/CIN-00-00-2f714bb9f962f634085d.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-01.png",
          "sha256": "0adc6a3e741eaadb1dab6bcf007c6432ee3185aa33252ea92aa2d2d50e8d0427",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 0,
          "start": 0,
          "end": 9,
          "zh": "山路拋錨使行程耽擱四小時。凌晨三點，我抵達山屋。",
          "en": "A breakdown delayed me by four hours. I reached the cabin at three in the morning."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-01-fa9094bbef43d5e76e6e.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-02.png",
          "sha256": "78973fcaca950e6ce22f1253c876fc8bb6282aad98a176318f6f9ce7713fe285",
          "person": null,
          "characterName": null,
          "frames": 252,
          "title": "委託聯絡紀錄",
          "index": 1,
          "start": 9,
          "end": 19.5,
          "zh": "委託我的人，是記者林依瑤。她害怕那封邀請背後的意思。",
          "en": "The reporter Lin Yiyao had hired me. The invitation frightened her."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-02-2240f5e2a1842e5b9010.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-02.png",
          "sha256": "78973fcaca950e6ce22f1253c876fc8bb6282aad98a176318f6f9ce7713fe285",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "聚會邀請函",
          "index": 2,
          "start": 19.5,
          "end": 28.5,
          "zh": "邀請函來自主辦人王杰倫。五年前，他從另一場大火中活了下來。",
          "en": "The invitation was signed by Wang Jielun, survivor of another fire five years ago."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-03-503248ad4c91e5fb0311.mp4",
          "sourceArt": "assets/art-redesign-v4/portraits/reporter.png",
          "sha256": "11c4d57430c2adf119a018aae5378d5ffb2665a73c4827a7eb531d7e4032d9fb",
          "person": "reporter",
          "characterName": "林依瑤",
          "frames": 192,
          "title": "林依瑤｜記者",
          "index": 3,
          "start": 28.5,
          "end": 36.5,
          "zh": "林依瑤，記者。受邀採訪五週年聚會，私下委託偵探保護。",
          "en": "Lin Yiyao, Reporter. Invited to cover the anniversary; privately hired the detective."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-04-9df1be5a03d0fd3d2d99.mp4",
          "sourceArt": "assets/art-redesign-v4/portraits/host.png",
          "sha256": "b2a3ee249edefd590adad5eb79d2a614108b58f854e19de17c2a503501fe21dc",
          "person": "host",
          "characterName": "王杰倫",
          "frames": 192,
          "title": "王杰倫｜聚會主辦人",
          "index": 4,
          "start": 36.5,
          "end": 44.5,
          "zh": "王杰倫，聚會主辦人。五年前火災倖存者，邀請與舊事相關的人重返山屋。",
          "en": "Wang Jielun, Host. Survivor of the old fire; invited people connected to the past."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-05-76d45d8155c88ea4c0f4.mp4",
          "sourceArt": "assets/art-redesign-v4/portraits/benefactor.png",
          "sha256": "68712b64adad2c56436b25dd4c32ed612769e62b444bb18267e9d28fad2ebd4a",
          "person": "benefactor",
          "characterName": "劉涵",
          "frames": 192,
          "title": "劉涵｜成年恩人好友",
          "index": 5,
          "start": 44.5,
          "end": 52.5,
          "zh": "劉涵，成年恩人好友。長期送物資照顧王杰倫，希望用烤肉派對讓他重新生活。",
          "en": "Liu Han, Adult friend and benefactor. Supported Wang for years and hoped the barbecue would cheer him."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-06-9fcfdf723c232c3f3ff4.mp4",
          "sourceArt": "assets/art-redesign-v4/portraits/doctor.png",
          "sha256": "bf69c0f7a5d82110c2bc7f634dfca9d5bade85fcceeae7484a66da16f4860a9f",
          "person": "doctor",
          "characterName": "張萍",
          "frames": 192,
          "title": "張萍｜心理醫生",
          "index": 6,
          "start": 52.5,
          "end": 60.5,
          "zh": "張萍，心理醫生。受邀見證聲稱的康復，攜帶個案紀錄與醫療公事包。",
          "en": "Zhang Ping, Psychological clinician. Invited to witness a claimed recovery; carried case records."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-07-eae064c5083b62289634.mp4",
          "sourceArt": "assets/art-redesign-v4/portraits/photographer.png",
          "sha256": "94fffbf0a09491bd7d7fc7dbb035e92666af48f7a8e452aa69d6e47b77857539",
          "person": "photographer",
          "characterName": "劉子傑",
          "frames": 192,
          "title": "劉子傑｜攝影師",
          "index": 7,
          "start": 60.5,
          "end": 68.5,
          "zh": "劉子傑，攝影師。受酬拍攝紀念照，以手機記錄工作花絮，兩張合照都在鏡頭後。",
          "en": "Liu Zijie, Photographer. Paid to photograph the gathering; recorded work fragments and stayed behind the camera."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-08-a5004b56718ed1584870.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-04.png",
          "sha256": "848137e6740ecb75ff016e5d1736fa08a47612f647c1a354b65393f8c3458b49",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "02:30現場通報",
          "index": 8,
          "start": 68.5,
          "end": 77.5,
          "zh": "警方通報四具成年人焦屍，身分待驗；起火原因仍在調查。",
          "en": "Four adult bodies, identification pending. The cause remained under investigation."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-00-09-12aefc689624913c71b4.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-03.png",
          "sha256": "a5a644a0a37e4359f527d3d24799660321bdf9dd8b409f5d2163ba6d6453d0c9",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 9,
          "start": 77.5,
          "end": 86.5,
          "zh": "我留在封鎖線外，取得許可後，只沿已確認的安全區調查。",
          "en": "I waited outside the cordon, then entered only the cleared investigation route."
        }
      ],
      "audioSource": "assets/playback-v6/video/CIN-00-compatible-v7.mp4",
