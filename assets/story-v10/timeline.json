        },
        {
          "path": "assets/playback-v6/video/CIN-END-compatible-v10.webm",
          "type": "video/webm; codecs=\"vp9, opus\"",
          "bytes": 6227255,
          "sha256": "8100de058756a9ed0965395336dea58bdba48a1b8c5fd57ad1d6d1667ba4f260",
          "decode": "pending"
        }
      ],
      "tracks": {
        "zh-Hant": "assets/story-v10/CIN-END-zh-Hant-aligned-v10.vtt",
