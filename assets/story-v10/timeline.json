          "sha256": "aa40e6a8f68aa6ba64110de1b65e561f3437a9497a39321926c645bac3eb2221",
          "decode": "pending"
        }
      ],
      "tracks": {
        "zh-Hant": "assets/story-v10/CIN-D-zh-Hant-aligned-v10.vtt",
        "en": "assets/story-v10/CIN-D-en-aligned-v10.vtt"
      },
      "poster": "assets/story-v10/CIN-D-v10.webp"
    },
    {
      "id": "CIN-END",
      "duration": 72,
      "frames": 1728,
      "shots": [
        {
          "file": "assets/story-v10/.render-cache/CIN-END-00-d68e746c45628db46fd1.mp4",
          "sourceArt": "assets/art-redesign-v4/images/D-05.png",
          "sha256": "53f9787149eabbe2bd33fdc93031bfa42fcf314f4c1bc4f40f123e658e4dc815",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 0,
          "start": 0,
          "end": 9,
          "zh": "【真相重建】王杰倫利用聚會控制舊事相關者，氣味觸發後，對劉涵與其餘三人下手。",
          "en": "[Truth reconstructed] Wang used the gathering for control. The smell triggered the attacks on Liu Han and the others."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-01-e3c711c9c1b4b557761a.mp4",
          "sourceArt": "assets/art-redesign-v4/images/00-04.png",
          "sha256": "848137e6740ecb75ff016e5d1736fa08a47612f647c1a354b65393f8c3458b49",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 1,
          "start": 9,
          "end": 18,
          "zh": "他反鎖主門並引發火災掩飾，火開始蔓延時，從維修出口離開。",
          "en": "He bolted the main door and set the new fire to conceal the crime, escaping as it spread."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-02-2e39fdda82a9da7cc280.mp4",
          "sourceArt": "assets/art-redesign-v4/images/D-06.png",
          "sha256": "57d7d16fb87455314f80ab5d7579c3f10d670a2a21473ac4dee5ad9cc062cb1c",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 2,
          "start": 18,
          "end": 27,
          "zh": "之後鐵櫃倒下。貼屋露台與烤架塌向低側客廳，先遇害的劉涵也包括在四具遺體中。",
          "en": "The cabinet fell later. The terrace and grill collapsed toward the lower living room; Liu Han was included among the four bodies."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-03-a4316e2768504d143c54.mp4",
          "sourceArt": "assets/art-redesign-v4/images/END-PLATE.png",
          "sha256": "d5d955421a4190a61e5caa05c441cdc25661161dc4d8bc79d7079106dd5f9e6d",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 3,
          "start": 27,
          "end": 36,
          "zh": "我朝森林出口奔去。身後的視角，卻留在原地。",
          "en": "I ran toward the forest exit. The viewpoint behind me remained still."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-04-20bd0592dd82bed9d6cc.mp4",
          "sourceArt": "assets/art-redesign-v4/images/END-03.png",
          "sha256": "8e72f314b817e0016bda9fdc82ddbf38253bf9a1bd11eacafe126c9165f29e98",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 4,
          "start": 36,
          "end": 45,
          "zh": "當晚返回取控制器的身影，躲入了枯樹。有人一直注視這裡。",
          "en": "Returning for the controller that night, a figure hid in the hollow tree. Someone was watching."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-05-59f6332ccf320b11f32d.mp4",
          "sourceArt": "assets/art-redesign-v4/images/END-04.png",
          "sha256": "edab095bf31f576804eb1cae18559d5f37b3ec432661b5ce35eb6ad6a594edcf",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 5,
          "start": 45,
          "end": 54,
          "zh": "［吞嚥聲］控制器當前值歸零，固定底座的歷史紀錄並未刪除。",
          "en": "[Swallowing] The controller’s current reading reset. History remained in the fixed base."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-06-6a67564b65d6ef2531d5.mp4",
          "sourceArt": "assets/art-redesign-v4/images/END-05.png",
          "sha256": "1db0dafbef4bcf105c9b6843ccc45f2c050d1a0f6abd634edde947361ef37190",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 6,
          "start": 54,
          "end": 63,
          "zh": "冷光照亮那張熟悉的臉。王杰倫還活著。",
          "en": "Cold light revealed the familiar face. Wang Jielun was alive."
        },
        {
          "file": "assets/story-v10/.render-cache/CIN-END-07-ad8aa2dc3335f746f476.mp4",
          "sourceArt": "assets/art-redesign-v4/images/END-PLATE.png",
          "sha256": "d5d955421a4190a61e5caa05c441cdc25661161dc4d8bc79d7079106dd5f9e6d",
          "person": null,
          "characterName": null,
          "frames": 216,
          "title": "",
          "index": 7,
          "start": 63,
          "end": 72,
          "zh": "真相有時比廢墟還要焦黑。真正的怪物，已隱入森林。",
          "en": "Truth can be darker than the ruins. The monster had vanished into the forest."
        }
      ],
      "audioSource": "assets/playback-v6/video/CIN-END-compatible-v7.mp4",
      "sources": [
        {
          "path": "assets/playback-v6/video/CIN-END-compatible-v10.mp4",
          "type": "video/mp4; codecs=\"avc1.64001F, mp4a.40.2\"",
          "bytes": 3196705,
          "sha256": "28abcd886b0f3f2b1822e2b522ae88ab08c7be03ab68d74335dbea8cb6bb6f0c",
