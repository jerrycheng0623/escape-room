{
  "name": "embers-sixth-person",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/game/*.test.mjs",
    "test:ui": "node scripts/test-v4.mjs",
    "test:space": "node scripts/test-space-ui.mjs",
    "test:media": "node scripts/test-media.mjs",
    "test:media:controls": "node scripts/test-media-controls.mjs",
    "test:media:http": "node scripts/test-media-http.mjs",
    "test:media:layout": "node scripts/test-media-layout.mjs",
    "test:media:story": "node scripts/test-media-story.mjs",
    "test:mobile": "EMBERS_DEVICE=mobile node scripts/test-v4.mjs",
    "test:mechanisms": "node scripts/test-v4-boundaries.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:touch": "node scripts/test-touch-controls.mjs",
    "test:keyboard": "node scripts/test-keyboard-audio.mjs",
    "test:post": "node scripts/test-postgame.mjs",
    "test:captions": "node scripts/test-caption-alignment.mjs",
    "test:notebook": "node scripts/test-notebook-controls.mjs",
    "test:q-input": "node scripts/test-q-guide-input.mjs",
    "test:native": "node scripts/test-native-exploration.mjs",
    "test:soundscape": "node scripts/test-soundscape.mjs",
    "test:settings": "node scripts/test-settings-guidance.mjs",
    "test:guide": "node scripts/test-guide-modes.mjs",
    "test:luggage": "node scripts/test-luggage-input.mjs",
    "test:layout": "node scripts/test-final-layout.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "@vitejs/plugin-react": "^5.1.0"
  }
}
